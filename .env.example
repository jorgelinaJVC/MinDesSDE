# Copiá este archivo con el nombre .env y completá los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore): ahí van las contraseñas.

# Conexión a MongoDB Atlas (Database > Connect > Drivers).
# Reemplazá USUARIO y CLAVE por los del usuario de base de datos.
MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Puerto del servidor
PORT=3000
