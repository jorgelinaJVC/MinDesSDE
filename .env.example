# Copiá este archivo con el nombre .env y completá los valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore): ahí van las contraseñas.

# Conexión a MongoDB Atlas (Database > Connect > Drivers).
# Reemplazá USUARIO y CLAVE por los del usuario de base de datos.
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DB_NAME=nexo_institucional

# Puerto del servidor
PORT=3000

# En el servidor real poné "production": activa cookies seguras (solo HTTPS) y HSTS.
# En tu computadora dejalo en "development" (si no, el login no funciona en http://localhost).
NODE_ENV=development

# Horas que dura una sesión antes de pedir login de nuevo
SESION_HORAS=8

# Solo si el servidor está detrás de un proxy (nginx, Cloudflare): cuántos saltos confiar para obtener la IP real.
# CONFIAR_PROXY=1

# Solo para mostrar el portal a través de un túnel (por ejemplo, Ports de VS Code en modo Public):
# la dirección del túnel, para que el login funcione desde ahí. Borrala cuando termines la demo.
# ORIGENES_PERMITIDOS=https://abc123-3000.brs.devtunnels.ms
