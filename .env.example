# Copiá este archivo como .env y completá los valores. No lo subas a git.

# Base de datos MongoDB 6.0 o superior (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
# Con usuario y clave:  mongodb://nexo:cambia-esta-clave@127.0.0.1:27017/?authSource=nexo_institucional
# En Atlas:             mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/
DB_NAME=nexo_institucional

# Servidor
PORT=3000
NODE_ENV=development        # en producción: production (activa cookies Secure y HSTS)
SESION_HORAS=8              # duración de la sesión
# BCRYPT_COSTO=12           # costo del hash de contraseñas
# CARPETA_ADJUNTOS=./almacen

# Solo para "npm run bd:sembrar" (datos de ejemplo). Cambiala si la base es compartida.
# SEMILLA_PASSWORD=Nexo-demo-2026

# Solo para las pruebas: esta base SE BORRA en cada corrida (debe contener "prueba" o "test")
# DB_NAME_PRUEBAS=nexo_pruebas
